#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

echo COLLECTSTATIC
python /app/manage.py collectstatic --noinput
echo MIGRATE
python /app/manage.py showmigrations
python /app/manage.py migrate
echo UPDATE SURVEY
python /app/manage.py update_survey_questions
echo UPDATETRANSLATIONS
python /app/manage.py compilemessages

exec gunicorn config.wsgi --bind 0.0.0.0:5000 --chdir=/app --workers=2 --timeout=120
